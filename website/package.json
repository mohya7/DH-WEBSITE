{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "gen:types": "tsx scripts/generate-schema-types.ts",
    "prepare:content": "tsx scripts/prepare-content.ts",
    "prepare:design": "tsx scripts/prepare-design.ts",
    "dev": "npm run gen:types -- --check && npm run prepare:content && npm run prepare:design && next dev",
    "build": "npm run gen:types -- --check && npm run prepare:content && npm run prepare:design && next build && tsx scripts/strip-runtime.ts && tsx scripts/write-seo.ts && tsx scripts/write-web-config.ts && tsx scripts/check-output.ts",
    "webconfig": "tsx scripts/write-web-config.ts",
    "check:csp": "tsx scripts/check-csp.ts",
    "strip:runtime": "tsx scripts/strip-runtime.ts",
    "check:output": "tsx scripts/check-output.ts",
    "design:check": "tsx scripts/design-sources.ts",
    "design:port": "tsx scripts/design-sources.ts --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "compare:sections": "node tools/section-compare/run.mjs",
    "compare:screenshots": "node tools/screenshot-parity/compare.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "jsdom": "30.1.2",
    "pixelmatch": "7.2.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
