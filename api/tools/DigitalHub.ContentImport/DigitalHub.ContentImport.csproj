<!-- Web SDK: Application Control on this machine blocks a console-sdk assembly. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CETCompat>true</CETCompat>
    <!-- The apphost exe is blocked by Application Control after each rebuild. dotnet runs the dll. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="JsonSchema.Net" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DigitalHub.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DigitalHub.Api\DigitalHub.Api.csproj" />
    <ProjectReference Include="..\..\src\DigitalHub.Images\DigitalHub.Images.csproj" />
  </ItemGroup>

</Project>
