{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Auth": {
    "Issuer": "digitalhub",
    "Audience": "digitalhub-api",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14,
    "SessionMaxDays": 30,
    "LoginPermitLimit": 8,
    "LoginWindowHours": 1
  },
  "Contact": {
    "PermitLimit": 10,
    "WindowHours": 1
  },
  "Apply": {
    "IpPermitLimit": 10,
    "EmailPermitLimit": 5,
    "WindowHours": 1
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "From": "careers@digitalhub.com.eg",
    "TimeoutSeconds": 15,
    "User": "",
    "Password": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Security": {
    "HstsEnabled": false
  },
  "AllowedHosts": "*"
}
