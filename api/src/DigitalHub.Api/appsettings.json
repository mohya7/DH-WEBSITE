{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Auth": {
    "Issuer": "digitalhub",
    "Audience": "digitalhub-api",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14,
    "LoginPermitLimit": 8,
    "LoginWindowHours": 1
  },
  "Contact": {
    "PermitLimit": 10,
    "WindowHours": 1
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Security": {
    "HstsEnabled": false
  },
  "AllowedHosts": "*"
}
