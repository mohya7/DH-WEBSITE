<!--
  ISO-2 (ADR 0001, point 1): the public forms API. It references the forms
  library only: never DigitalHub.Api or DigitalHub.Images, and no Identity,
  JwtBearer or health-checks package. It has no UserSecretsId, so in
  Development no user-secrets store (and so no Auth:SigningKey) is loaded.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalHub.Forms\DigitalHub.Forms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- SqlClient 6.1.6 pulls 9.0.11. GHSA-846f-f764-76mx is fixed in 9.0.21. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

</Project>
