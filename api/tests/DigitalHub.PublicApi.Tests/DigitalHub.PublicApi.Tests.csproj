<!-- Web SDK: a class-library test assembly is blocked by Application Control on this machine. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <CETCompat>true</CETCompat>
    <!--
      The admin API's store, read by PublicApiFactory for ConnectionStrings:Content
      only. It is this test assembly's attribute: the public host loads user
      secrets only for DigitalHub.PublicApi, which has no id (ISO-2, 3.5).
    -->
    <UserSecretsId>41335d15-4f42-410a-bf90-41068117e45a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="DigitalHub.Forms" />
    <Compile Include="..\Shared\ReferenceGuard.cs" Link="Shared\ReferenceGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public API and the forms library only: this suite cannot see DigitalHub.Api. -->
    <ProjectReference Include="..\..\src\DigitalHub.PublicApi\DigitalHub.PublicApi.csproj" />
    <ProjectReference Include="..\..\src\DigitalHub.Forms\DigitalHub.Forms.csproj" />
  </ItemGroup>

</Project>
