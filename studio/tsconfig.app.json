{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "composite": true,
    "paths": {
      "@digitalhub/theme/*": ["../packages/theme/*"],
      "@digitalhub/blocks": ["../packages/blocks/src/index.ts"],
      "@digitalhub/blocks/*": ["../packages/blocks/src/*"],
      "@digitalhub/website-design/*": ["../website/src/design/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "../packages/theme/tokens.ts", "../packages/blocks/src/**/*.ts", "../packages/blocks/src/**/*.tsx", "../website/src/design/sets.ts"]
}
