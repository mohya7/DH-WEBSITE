{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalhub.local/sections/stats",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "eyebrow": { "type": "string", "x-dh-kind": "text" },
    "heading": { "type": "string", "x-dh-kind": "text" },
    "lead": { "type": "string", "x-dh-kind": "longText" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "x-dh-kind": "text" },
          "label": { "type": "string", "x-dh-kind": "longText" }
        }
      }
    }
  }
}
