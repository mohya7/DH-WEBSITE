{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalhub.local/sections/faq",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "x-dh-kind": "text" },
          "answer": { "type": "string", "x-dh-kind": "longText" }
        }
      }
    }
  }
}
