{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalhub.local/sections/industries",
  "type": "object",
  "additionalProperties": false,
  "required": ["heading", "items"],
  "properties": {
    "eyebrow": { "type": "string", "x-dh-kind": "text" },
    "heading": { "type": "string", "x-dh-kind": "text" },
    "lead": { "type": "string", "x-dh-kind": "longText" },
    "items": {
      "type": "array",
      "items": { "$ref": "https://digitalhub.local/sections/defs#/$defs/textPair" }
    }
  }
}
